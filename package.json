{
  "name": "mcp-oda",
  "version": "1.0.0",
  "description": "Integration with Oda for searching products and managing your shopping cart.",
  "main": "dist/index.js",
  "bin": {
    "mcp-oda": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/integration.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^15.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "run.sh"
  ]
}
